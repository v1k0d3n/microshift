! MicroShift 2-Node HA keepalived configuration
! Generated by MicroShift — do not edit manually.

vrrp_script chk_apiserver {
    script "/usr/libexec/microshift/check-apiserver.sh"
    interval 2
    weight -50
    fall 3
    rise 2
}

vrrp_instance MICROSHIFT_VIP {
    state {{ .State }}
    interface {{ .Interface }}
    virtual_router_id {{ .VirtualRouterID }}
    priority {{ .Priority }}
    advert_int 1

    authentication {
        auth_type PASS
        auth_pass {{ .AuthPass }}
    }

    virtual_ipaddress {
        {{ .VIP }}/{{ .PrefixLen }}
    }

    track_script {
        chk_apiserver
    }
}
